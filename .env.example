# Copy to .env (git-ignored). Every value is optional; features degrade gracefully.

# --- LLM: any OpenAI-compatible endpoint. Hackathon path = GIDE local API (Ornith 1.0 / Qwen). ---
LLM_BASE_URL=            # GIDE: http://127.0.0.1:41337/v1 (printed by `gide apikey create`)
LLM_MODEL=               # GIDE: local
LLM_API_KEY=             # GIDE: sk-gide-...
LLM_SUPPORTS_TOOLS=false

# --- Tavily (web evidence for "why did X move") ---
TAVILY_API_KEY=

# --- PRISM by Block Convey (observability; required for the hackathon) ---
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app

# --- IBKR Client Portal Gateway (PAPER ONLY; account ids must start with DU/DF) ---
IBKR_GATEWAY_URL=https://localhost:5001/v1/api
IBKR_ACCOUNT_ID=
IBKR_PAPER_ONLY=true
# Flex Web Service (longer trade history)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# --- Robinhood (live sync via robin_stocks; CSV upload needs nothing) ---
RH_SESSION_DIR=
