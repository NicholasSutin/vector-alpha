# Copy to .env (git-ignored). Every value is optional; features degrade gracefully.

# --- LLM: any OpenAI-compatible endpoint. Two supported providers: ---
# (A) Cloudflare Workers AI (fast, cloud):
#     LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#     LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast      (or @cf/openai/gpt-oss-120b, @cf/qwen/qwen3-30b-a3b-fp8)
#     LLM_API_KEY=<Cloudflare API token with Workers AI read/run>
# (B) GIDE local API (offline, Apple Silicon): base http://127.0.0.1:41337/v1, model `local`, key sk-gide-... (from `gide apikey create`)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_SUPPORTS_TOOLS=false
LLM_TIMEOUT_S=90
# (C) OpenRouter (https://openrouter.ai/docs/quickstart): base https://openrouter.ai/api/v1, model e.g. meta-llama/llama-4-scout, key sk-or-v1-...
# Optional second provider, tried only when the primary errors or returns unusable JSON:
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# --- Tavily (web evidence for "why did X move") ---
TAVILY_API_KEY=

# --- PRISM by Block Convey (observability; required for the hackathon) ---
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app

# --- IBKR Client Portal Gateway (PAPER ONLY; account ids must start with DU/DF) ---
IBKR_GATEWAY_URL=https://localhost:5001/v1/api
IBKR_ACCOUNT_ID=
IBKR_PAPER_ONLY=true
# Flex Web Service (longer trade history)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# --- Robinhood (live sync via robin_stocks; CSV upload needs nothing) ---
RH_SESSION_DIR=
LLM_TIMEOUT_S=150
